{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "title": "HTTP 5xx rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "title": "Imported meals",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(increase(gastro_imported_meals_total[24h])) by (type)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "title": "Import errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "increase(gastro_import_errors_total[24h])",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "title": "Last successful import",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "time() - gastro_last_import_timestamp",
          "legendFormat": "seconds since import"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Host memory available",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "available"
        }
      ]
    }
  ],
  "schemaVersion": 41,
  "style": "dark",
  "tags": [
    "gastro",
    "production"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Gastro API Production",
  "uid": "gastro-api-production",
  "version": 1
}
