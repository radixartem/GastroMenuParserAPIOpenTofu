hcloud_token = "<your-api-token>"
ssh_key_ids  = [123456]

servers = {
  gastro-prod = {
    server_name = "gastro-prod"
    server_type = "cx22"
    image       = "ubuntu-26.04"
    location    = "fsn1"
    volume_role = "postgres"
  }
}

