# ============================================================
# Gastro Menu Parser API
# ============================================================

gastro.opik.net {
    encode zstd gzip

    # Do not expose Prometheus metrics publicly.
    @metrics path /metrics*
    respond @metrics 404

    # Do not expose internal health endpoints publicly.
    @internalHealth path /health*
    respond @internalHealth 404

    reverse_proxy api:8080

    log {
        output stdout
        format json
    }
}


# ============================================================
# Grafana
# ============================================================

grafana.accesscam.org {
    encode zstd gzip

    reverse_proxy grafana:3000

    log {
        output stdout
        format json
    }
}